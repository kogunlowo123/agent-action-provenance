{
  "$defs": {
    "BundleEntry": {
      "properties": {
        "inclusion_proof": {
          "$ref": "#/$defs/InclusionProof"
        },
        "leaf_index": {
          "minimum": 0,
          "title": "Leaf Index",
          "type": "integer"
        },
        "record": {
          "additionalProperties": true,
          "description": "ProvenanceRecord exactly as sealed in the log",
          "title": "Record",
          "type": "object"
        }
      },
      "required": [
        "leaf_index",
        "record",
        "inclusion_proof"
      ],
      "title": "BundleEntry",
      "type": "object"
    },
    "InclusionProof": {
      "properties": {
        "audit_path": {
          "items": {
            "type": "string"
          },
          "title": "Audit Path",
          "type": "array"
        },
        "leaf_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Leaf Hash",
          "type": "string"
        },
        "leaf_index": {
          "minimum": 0,
          "title": "Leaf Index",
          "type": "integer"
        },
        "tree_size": {
          "minimum": 1,
          "title": "Tree Size",
          "type": "integer"
        }
      },
      "required": [
        "leaf_index",
        "tree_size",
        "leaf_hash",
        "audit_path"
      ],
      "title": "InclusionProof",
      "type": "object"
    },
    "LogPublicKey": {
      "properties": {
        "algorithm": {
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "log_id": {
          "title": "Log Id",
          "type": "string"
        },
        "public_key_pem": {
          "title": "Public Key Pem",
          "type": "string"
        }
      },
      "required": [
        "log_id",
        "public_key_pem"
      ],
      "title": "LogPublicKey",
      "type": "object"
    },
    "SignedTreeHead": {
      "description": "Ed25519 signature over the canonical JSON of the unsigned fields.",
      "properties": {
        "log_id": {
          "description": "SHA-256 of the log key SPKI",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Log Id",
          "type": "string"
        },
        "root_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Hash",
          "type": "string"
        },
        "signature": {
          "description": "Base64 Ed25519 signature",
          "title": "Signature",
          "type": "string"
        },
        "timestamp": {
          "description": "Milliseconds since the Unix epoch",
          "minimum": 0,
          "title": "Timestamp",
          "type": "integer"
        },
        "tree_size": {
          "minimum": 0,
          "title": "Tree Size",
          "type": "integer"
        },
        "version": {
          "default": "aap-sth/v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "log_id",
        "tree_size",
        "root_hash",
        "timestamp",
        "signature"
      ],
      "title": "SignedTreeHead",
      "type": "object"
    }
  },
  "$id": "https://github.com/kogunlowo123/agent-action-provenance/schemas/evidence-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "criteria": {
      "additionalProperties": true,
      "title": "Criteria",
      "type": "object"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/BundleEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "export_id": {
      "title": "Export Id",
      "type": "string"
    },
    "format": {
      "default": "aap-evidence-bundle/v1",
      "title": "Format",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "log": {
      "$ref": "#/$defs/LogPublicKey"
    },
    "tree_head": {
      "$ref": "#/$defs/SignedTreeHead"
    }
  },
  "required": [
    "export_id",
    "generated_at",
    "criteria",
    "log",
    "tree_head",
    "entries"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
